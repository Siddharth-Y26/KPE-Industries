{
  "name": "kpe-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-env.mjs && next build && node scripts/flatten-prefetch.mjs && node scripts/generate-headers.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "node scripts/check-env.mjs --strict && npm run build && wrangler deploy",
    "deploy:pages": "node scripts/publish-pages.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
