# Copy to .env.production (never committed) and fill in before a production build.
# Only NEXT_PUBLIC_ values reach the browser. They are baked in at build time.

# Final site address, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=

# WhatsApp Business number in international format, digits only (e.g. 9198XXXXXXXX).
# Leave blank until the client confirms it; WhatsApp buttons stay hidden while blank.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Cloudflare Turnstile site key. Leave blank to run the form without a challenge.
# For local testing, 1x00000000000000000000AA always passes.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Web Analytics token. Leave blank for no analytics.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Only for a preview hosted in a sub-folder with no server, such as GitHub Pages.
# `npm run deploy:pages` sets these itself; leave them blank for the real domain.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_STATIC_PREVIEW=

# Optional overrides.
NEXT_PUBLIC_FORM_ENDPOINT=
NEXT_PUBLIC_MAPS_URL=

# ---------------------------------------------------------------------------
# Server-side values for the enquiry endpoint. These do NOT go in this file.
#   Local:      .dev.vars            (see .dev.vars.example)
#   Production: wrangler.jsonc vars  (EMAIL_FROM, EMAIL_TO, ALLOWED_ORIGINS)
#               wrangler secret put  (EMAIL_API_KEY, TURNSTILE_SECRET_KEY)
# ---------------------------------------------------------------------------
